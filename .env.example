# ClaimSaathi v4.0 Environment Configuration Template
# Copy to .env.local (never commit real secrets to Git!) and set matching values in Vercel Project Settings.

# 1. Neon Serverless PostgreSQL Connection String (Pooled or Owner)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# 2. Simple HS256 JWT Secret (use any strong random 32+ char string)
JWT_SECRET="replace-with-a-strong-random-32-char-secret"

# 3. Optional Admin Registration Invite Code (only users providing this during signup get 'admin' role)
ADMIN_INVITE_CODE="CLAIMSAATHI-ADMIN-2026"

# 4. Gmail / Standard SMTP Settings for Direct Deadline & Scheme Update Emails
# For Gmail: Enable 2-Step Verification -> Google Account -> App Passwords -> paste 16-char App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM="ClaimSaathi Alerts <your-gmail-address@gmail.com>"

# 5. Optional Vercel Cron Secret for Automated Scheduled Deadline Emails
CRON_SECRET="replace-with-random-cron-token"

# 6. Optional AI Explanation Enhancement (Zero-key deterministic engine works without this)
ANTHROPIC_API_KEY=""
